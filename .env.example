# TOKA GDMS — Environment Variables Template

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-in-frontend

# Africa's Talking Two-Way SMS Gateway
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_SENDER_ID=TOKA_GLASS
AFRICAS_TALKING_WEBHOOK_SECRET=your_webhook_verification_secret

# Application Host
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only. Never enable in deployed environments.
GDMS_DEMO_MODE=false
TOKA_NOTIFICATION_WORKER_SECRET=replace-with-a-random-secret-at-least-32-characters
